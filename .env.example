# TruckPark Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# Note: Brevo email credentials now live on the Oracle backend in backend/ords/01b_pkg_api_body.sql.
ORDS_BASE_URL=https://<adb-host>.oraclecloudapps.com/ords/
ORDS_MODULE_PATH=admin
ORDS_API_VERSION=v1

# Operator Session Auto-Logout Timeout
# Sets how long an operator remains logged in before being automatically logged out,
# ensuring staff log in again at the start of daily operations (e.g. '20h', '20hrs', '20', '1d', '2days').
# Defaults to 20h if omitted.
SESSION_TIMEOUT=20h

