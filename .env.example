# TruckPark Environment Configuration Template
# Copy this file to .env and adjust variables as needed
ORDS_BASE_URL=https://<adb-host>.oraclecloudapps.com/ords/
ORDS_MODULE_PATH=truckpark
ORDS_API_VERSION=v1
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=<brevo-login>
BREVO_SMTP_KEY=<brevo-smtp-key>
BREVO_SENDER_EMAIL=<verified-sender-email>
